   "id": "main",
   "path": "bsearch.py",
   "text": "def binary_search(arr, target):\n    lo, hi = 0, len(arr) - 1\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        if arr[mid] == target:\n            return mid\n        elif arr[mid] < target:\n            lo = mid + 1\n        else:\n            hi = mid - 1\n    return -1\n\n\nnums = [1, 3, 5, 7, 9, 11]\nindex = binary_search(nums, 7)\nprint(\"found at\", index)\n",
